<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <title>Edit Booking | EnrichHub</title>

    <style>
        body {
            background: #f4f6fb;
            font-family: Arial, sans-serif;
            margin: 0;
        }

        .container {
            max-width: 700px;
            margin: 50px auto;
            background: white;
            padding: 30px;
            border-radius: 15px;
            box-shadow: 0 2px 10px rgba(0, 0, 0, .1);
        }

        h1 {
            color: #35503f;
            margin-bottom: 20px;
        }

        .form-group {
            margin-bottom: 18px;
        }

        label {
            display: block;
            margin-bottom: 6px;
            font-weight: bold;
        }

        input,
        select {
            width: 100%;
            padding: 12px;
            border: 1px solid #ddd;
            border-radius: 8px;
        }

        .btn {
            background: #35503f;
            color: white;
            border: none;
            padding: 12px 20px;
            border-radius: 8px;
            cursor: pointer;
        }

        .btn:hover {
            opacity: 0.9;
        }

        .back-btn {
            display: inline-block;
            margin-bottom: 20px;
            text-decoration: none;
            color: #35503f;
            font-weight: bold;
        }
    </style>
</head>

<body>

    <div class="container">

        <a href="/learner/bookings" class="back-btn">
            ← Back to My Bookings
        </a>

        <h1>Edit Booking</h1>

        <form action="/learner/edit_booking/<%= booking.id %>" method="POST">

            <div class="form-group">
                <label>Learner Name</label>
                <input type="text" name="learner_name" value="<%= booking.learner_name %>" required>
            </div>

            <div class="form-group">
                <label>Email</label>
                <input type="email" name="email" value="<%= booking.email %>" required>
            </div>

            <div class="form-group">
                <label>Ticket Type</label>

                <select name="ticket_type">

                    <option value="Full Ticket" <%=booking.ticket_type==='Full Ticket' ? 'selected' : '' %>>
                        Full Ticket
                    </option>

                    <option value="Concession Ticket" <%=booking.ticket_type==='Concession Ticket' ? 'selected' : '' %>>
                        Concession Ticket
                    </option>

                </select>
            </div>

            <div class="form-group">
                <label>Quantity</label>
                <input type="number" name="quantity" min="1" value="<%= booking.quantity %>" required>
            </div>

            <button type="submit" class="btn">
                Save Changes
            </button>

        </form>

    </div>

</body>

</html>