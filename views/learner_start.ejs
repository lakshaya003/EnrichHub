<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Welcome to EnrichHub</title>

    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: Arial, Helvetica, sans-serif;
        }

        body {
            background: #f4f6fb;
            display: flex;
            justify-content: center;
            align-items: center;
            height: 100vh;
        }

        .welcome-card {
            background: white;
            width: 450px;
            padding: 50px;
            border-radius: 20px;
            text-align: center;
            box-shadow: 0 10px 25px rgba(0, 0, 0, 0.08);
        }

        .logo-container {
            margin-bottom: 20px;
        }

        .logo {
            width: 100px;
            height: 100px;
            object-fit: contain;
            display: block;
            margin: 0 auto;
        }

        h1 {
            color: #35503f;
            margin-bottom: 10px;
        }

        p {
            color: #666;
            margin-bottom: 30px;
            line-height: 1.5;
        }

        input {
            width: 100%;
            padding: 15px;
            border: 1px solid #ddd;
            border-radius: 10px;
            font-size: 16px;
            margin-bottom: 20px;
        }

        input:focus {
            outline: none;
            border-color: #35503f9d;
        }

        button {
            width: 100%;
            padding: 15px;
            border: none;
            border-radius: 10px;
            background: #35503f9d;
            color: white;
            font-size: 16px;
            font-weight: bold;
            cursor: pointer;
        }

        button:hover {
            opacity: 0.9;
        }

        .field-label {
            display: block;
            text-align: left;
            margin-bottom: 8px;
            font-weight: bold;
            color: #35503f;
        }

        select {
            width: 100%;
            padding: 15px;
            border: 1px solid #ddd;
            border-radius: 10px;
            font-size: 16px;
            margin-bottom: 20px;
            background: white;
            color: #333;
            cursor: pointer;
        }

        select:focus {
            outline: none;
            border-color: #35503f9d;
        }

        select option {
            padding: 10px;
        }

        .home-btn {
            position: absolute;
            top: 25px;
            left: 25px;
            background: #3c387ce7;
            color: white;
            text-decoration: none;
            padding: 10px 20px;
            border-radius: 8px;
            font-weight: bold;
            transition: 0.3s;
        }

        .home-btn:hover {
            opacity: 0.9;
        }
    </style>

</head>

<body>

    <a href="/" class="home-btn">
        ← Return to Home Page
    </a>

    <div class="welcome-card">

        <div class="logo-container">
            <img src="/logo.png" alt="EnrichHub Logo" class="logo">
        </div>

        <h1>Welcome to EnrichHub</h1>

        <p>
            Enter your name to begin exploring courses, workshops,
            and learning opportunities.
        </p>

        <form action="/learner/start" method="POST">

            <input type="text" name="learner_name" placeholder="Enter your name" required>

            <input type="email" name="email" placeholder="Enter your email" required>

            <label class="field-label">
                Age Group
            </label>

            <select name="age_group" required>

                <option value="">
                    Select Age Group
                </option>

                <option value="Children (8-11)">
                    Children (8-11)
                </option>

                <option value="Teens (12-16)">
                    Teens (12-16)
                </option>

                <option value="Young Adults (17-21)">
                    Young Adults (17-21)
                </option>

                <option value="Adults (22-45)">
                    Adults (22-45)
                </option>

                <option value="Seniors (50-65)">
                    Seniors (50-65)
                </option>

            </select>

            <button type="submit">
                Enter Portal
            </button>

        </form>

    </div>

</body>

</html>