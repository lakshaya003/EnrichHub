<!DOCTYPE html>

<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Draft Courses | EnrichHub</title>


    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: Arial, Helvetica, sans-serif;
        }

        body {
            background: #f4f6fb;
        }

        .sidebar {
            position: fixed;
            width: 250px;
            height: 100vh;
            background: #0f4674b5;
            padding-top: 30px;
        }

        .sidebar h2 {
            color: white;
            text-align: center;
            margin-bottom: 30px;
        }

        .sidebar a {
            display: block;
            color: white;
            text-decoration: none;
            padding: 15px 25px;
        }

        .sidebar a.active {
            background: white;
            color: #0f4674b5;
            font-weight: bold;
            border-left: 5px solid #fbbf24;
        }

        .sidebar a:hover {
            background: rgba(255, 255, 255, .15);
        }

        .main {
            margin-left: 250px;
            padding: 35px;
        }

        .back-btn {
            display: inline-block;
            margin-bottom: 25px;
            background: #0f4674b5;
            color: white;
            text-decoration: none;
            padding: 12px 20px;
            border-radius: 10px;
            font-weight: bold;
        }

        .back-btn:hover {
            opacity: .9;
        }

        .page-header {
            margin-bottom: 30px;
        }

        .page-header h1 {
            color: #0f4674;
            margin-bottom: 10px;
        }

        .page-header p {
            color: #666;
        }

        .course-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(500px, 1fr));
            gap: 25px;
        }

        .course-card {
            background: white;
            border-radius: 18px;
            padding: 25px;
            box-shadow: 0 4px 15px rgba(0, 0, 0, .08);
            transition: all .3s ease;
        }

        .course-card:hover {
            transform: translateY(-6px);
            box-shadow: 0 10px 25px rgba(0, 0, 0, .15);
        }

        .course-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 20px;
        }

        .course-title {
            color: #0f4674;
        }

        .status-badge {
            background: #fef3c7;
            color: #92400e;
            padding: 8px 14px;
            border-radius: 30px;
            font-size: 13px;
            font-weight: bold;
        }

        .details-grid {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 15px;
            margin-top: 20px;
        }

        .detail-box {
            background: #f8fafc;
            padding: 14px;
            border-radius: 12px;
        }

        .detail-box strong {
            display: block;
            color: #0f4674;
            margin-bottom: 5px;
        }

        .action-buttons {
            margin-top: 25px;
        }

        .btn {
            display: inline-block;
            background: #0f4674;
            color: white;
            text-decoration: none;
            padding: 12px 18px;
            border-radius: 10px;
            margin-right: 10px;
            font-weight: bold;
        }

        .publish-btn {
            display: inline-block;
            background: #10b981;
            color: white;
            text-decoration: none;
            padding: 12px 18px;
            border-radius: 10px;
            margin-right: 10px;
            font-weight: bold;
        }

        .publish-btn:hover {
            background: #059669;
        }

        .delete-btn {
            display: inline-block;
            background: #ef4444;
            color: white;
            text-decoration: none;
            padding: 12px 18px;
            border-radius: 10px;
            font-weight: bold;
        }

        .delete-btn:hover {
            background: #dc2626;
        }

        .empty-state {
            background: white;
            padding: 40px;
            border-radius: 15px;
            text-align: center;
            box-shadow: 0 2px 10px rgba(0, 0, 0, .08);
        }

        .description {
            color: #444;
            line-height: 1.6;
            margin-bottom: 20px;
        }

        .sidebar-brand {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 0 20px;
            margin-bottom: 30px;
        }

        .sidebar-logo {
            width: 60px;
            height: 60px;
            border-radius: 50%;
            object-fit: cover;
        }

        .sidebar-brand h2 {
            color: white;
            margin: 0;
            font-size: 24px;
        }
    </style>


</head>

<body>

    <div class="sidebar">
        <div class="sidebar-brand">

            <img src="/logo.png" alt="EnrichHub Logo" class="sidebar-logo">

            <h2 onclick="location.href='/organiser'" style="cursor:pointer;">
                EnrichHub
            </h2>

        </div>

        <a href="/organiser">Dashboard</a>

        <a href="/organiser/create_new_course" class="<%= activePage === 'create' ? 'active' : '' %>">
            Create New Course
        </a>

        <a href="/organiser/published" class="<%= activePage === 'published' ? 'active' : '' %>">
            Published Courses
        </a>

        <a href="/organiser/edit_course" class="<%= activePage === 'drafts' ? 'active' : '' %>">
            Draft Courses
        </a>

        <a href="/organiser/bookings" class="<%= activePage === 'bookings' ? 'active' : '' %>">
            Learner Bookings
        </a>

        <a href="/organiser/analytics" class="<%= activePage === 'analytics' ? 'active' : '' %>">
            Analytics
        </a>

        <a href="/organiser/site_settings" class="<%= activePage === 'site_settings' ? 'active' : '' %>">
            Site Settings
        </a>


    </div>

    <div class="main">

        <a href="/organiser" class="back-btn">
            ← Back to Dashboard
        </a>

        <div class="page-header">
            <h1>Draft Courses</h1>
            <p>
                Manage, update and publish your draft courses.
            </p>
        </div>

        <% if(draftEvents.length===0){ %>

            <div class="empty-state">
                <h2>No Draft Courses</h2>
                <br>
                <p>
                    You currently have no draft courses available.
                </p>
            </div>

            <% } else { %>

                <div class="course-grid">

                    <% draftEvents.forEach(event=> { %>

                        <div class="course-card">

                            <div class="course-header">

                                <h2 class="course-title">
                                    <%= event.title %>
                                </h2>

                                <span class="status-badge">
                                    DRAFT
                                </span>

                            </div>
                            <p class="description">
                                <%= event.description %>
                            </p>

                            <div class="details-grid">

                                <div class="detail-box">
                                    <strong>Course Date</strong>
                                    <%= new Date(event.event_date).toLocaleDateString('en-GB') %>
                                </div>

                                <div class="detail-box">
                                    <strong>Category</strong>
                                    <%= event.category || 'N/A' %>
                                </div>

                                <div class="detail-box">
                                    <strong>Age Group</strong>
                                    <%= event.age_group || 'N/A' %>
                                </div>

                                <div class="detail-box">
                                    <strong>Venue</strong>
                                    <%= event.venue || 'N/A' %>
                                </div>

                                <div class="detail-box" style="grid-column: span 2;">

                                    <strong>💰 Ticket Pricing</strong>

                                    <div style="
                                        display:flex;
                                        gap:10px;
                                        margin-top:10px;
                                    ">

                                        <div style="
                                            flex:1;
                                            background:#eaf4ff;
                                            padding:12px;
                                            border-radius:8px;
                                            text-align:center;
                                        ">

                                            <div style="
                                                font-size:12px;
                                                color:#0f4674;
                                                font-weight:bold;
                                                margin-bottom:5px;
                                            ">
                                                Full Ticket
                                            </div>

                                            <div style="
                                                font-size:22px;
                                                font-weight:bold;
                                                color:#0f4674;
                                            ">
                                                $<%= Number(event.full_ticket_price).toFixed(2) %>
                                            </div>

                                        </div>

                                        <div style="
                                            flex:1;
                                            background:#fef3c7;
                                            padding:12px;
                                            border-radius:8px;
                                            text-align:center;
                                        ">

                                            <div style="
                                                font-size:12px;
                                                color:#92400e;
                                                font-weight:bold;
                                                margin-bottom:5px;
                                            ">
                                                Concession Ticket
                                            </div>

                                            <div style="
                                                font-size:22px;
                                                font-weight:bold;
                                                color:#92400e;
                                            ">
                                                $<%= Number(event.concession_ticket_price).toFixed(2) %>
                                            </div>

                                        </div>

                                    </div>

                                </div>

                                <div class="detail-box">
                                    <strong>Full Tickets</strong>
                                    <%= event.full_ticket_qty %>
                                </div>

                                <div class="detail-box">
                                    <strong>Concession Tickets</strong>
                                    <%= event.concession_ticket_qty %>
                                </div>

                                <div class="detail-box">
                                    <strong>Created On</strong>
                                    <%= new Date(event.created_at).toLocaleString('en-GB') %>
                                </div>

                                <div class="detail-box">
                                    <strong>Last Modified</strong>
                                    <%= event.modified_at ? new Date(event.modified_at).toLocaleString('en-GB')
                                        : 'Never Modified' %>
                                </div>

                            </div>

                            <div class="action-buttons">

                                <a href="/organiser/edit_course/<%= event.id %>" class="btn">
                                    Edit
                                </a>

                                <a href="/organiser/publish/<%= event.id %>" class="publish-btn">
                                    Publish
                                </a>

                                <a href="/organiser/delete/<%= event.id %>" class="delete-btn"
                                    onclick="return confirm('Delete this event?')">
                                    Delete
                                </a>

                            </div>

                        </div>

                        <% }) %>

                </div>

                <% } %>

    </div>

</body>

</html>