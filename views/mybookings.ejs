<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>My Bookings | EnrichHub</title>

    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: Arial, Helvetica, sans-serif;
        }

        body {
            background: #f4f6fb;
        }

        .sidebar {
            position: fixed;
            width: 250px;
            height: 100vh;
            background: #35503f9d;
            padding-top: 30px;
        }

        .sidebar h2 {
            color: white;
            text-align: center;
            margin-bottom: 30px;
            cursor: pointer;
        }

        .sidebar a {
            display: block;
            color: white;
            text-decoration: none;
            padding: 15px 25px;
        }

        .sidebar a.active {
            background: white;
            color: #35503f;
            font-weight: bold;
            border-left: 5px solid #fbbf24;
        }

        .sidebar a:hover {
            background: rgba(255, 255, 255, 0.15);
        }

        .main {
            margin-left: 250px;
            padding: 30px;
        }

        .header {
            margin-bottom: 30px;
        }

        .header h1 {
            color: #222;
            margin-bottom: 10px;
        }

        .header p {
            color: #666;
        }

        .booking-card {
            background: white;
            padding: 25px;
            border-radius: 15px;
            margin-bottom: 20px;
            box-shadow: 0 2px 10px rgba(0, 0, 0, .1);
        }

        .booking-card h2 {
            color: #35503f;
            margin-bottom: 15px;
        }

        .booking-card p {
            margin-bottom: 10px;
            color: #555;
        }

        .label {
            font-weight: bold;
            color: #222;
        }

        .status {
            display: inline-block;
            background: #dcfce7;
            color: #166534;
            padding: 6px 12px;
            border-radius: 20px;
            font-size: 14px;
            font-weight: bold;
            margin-top: 10px;
        }

        .actions {
            margin-top: 20px;
        }

        .edit-btn {
            display: inline-block;
            background: #35503f;
            color: white;
            text-decoration: none;
            padding: 10px 18px;
            border-radius: 8px;
            margin-right: 10px;
            font-weight: bold;
        }

        .edit-btn:hover {
            opacity: 0.9;
        }

        .cancel-btn {
            display: inline-block;
            background: #ef4444;
            color: white;
            text-decoration: none;
            padding: 10px 18px;
            border-radius: 8px;
            font-weight: bold;
        }

        .cancel-btn:hover {
            background: #dc2626;
        }

        .empty-state {
            background: white;
            padding: 40px;
            border-radius: 15px;
            text-align: center;
            box-shadow: 0 2px 10px rgba(0, 0, 0, .1);
        }

        .empty-state p {
            color: #666;
            font-size: 18px;
        }

        .back-btn {
            display: inline-block;
            background: #35503f9d;
            color: white;
            text-decoration: none;
            padding: 10px 20px;
            border-radius: 8px;
            margin-bottom: 25px;
            font-weight: bold;
        }

        .back-btn:hover {
            opacity: 0.9;
        }

        .sidebar-brand {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 0 20px;
            margin-bottom: 30px;
        }

        .sidebar-logo {
            width: 60px;
            height: 60px;
            border-radius: 50%;
            object-fit: cover;
        }

        .sidebar-brand h2 {
            color: white;
            margin: 0;
            font-size: 24px;
        }
    </style>

</head>

<body>

    <div class="sidebar">

        <div class="sidebar-brand">

            <img src="/logo.png" alt="EnrichHub Logo" class="sidebar-logo">

            <h2 onclick="location.href='/learner'" style="cursor:pointer;">
                EnrichHub
            </h2>

        </div>

        <a href="/learner">
            Learner Dashboard
        </a>

        <a href="/learner/courses">
            Browse Courses
        </a>

        <a href="/learner/bookings" class="active">
            My Bookings
        </a>
        <a href="/learner/profile">
            My Profile
        </a>

    </div>

    <div class="main">

        <div class="header">

            <a href="/learner" class="back-btn">
                ← Back to Learner Dashboard
            </a>

            <h1>My Bookings</h1>

            <p>
                View, edit or cancel your course bookings.
            </p>

        </div>

        <% if (bookings.length===0) { %>

            <div class="empty-state">

                <h2>No Bookings Found</h2>

                <br>

                <p>
                    You have not booked any courses yet.
                </p>

            </div>

            <% } else { %>

                <% bookings.forEach(function(booking) { %>

                    <div class="booking-card">

                        <h2>
                            <%= booking.title %>
                        </h2>

                        <p>
                            <span class="label">Learner Name:</span>
                            <%= booking.learner_name %>
                        </p>

                        <p>
                            <span class="label">Email:</span>
                            <%= booking.email %>
                        </p>

                        <p>
                            <span class="label">Ticket Type:</span>
                            <%= booking.ticket_type %>
                        </p>

                        <p>
                            <span class="label">Quantity:</span>
                            <%= booking.quantity %>
                        </p>

                        <p>
                            <span class="label">Booking Date:</span>
                            <%= new Date(booking.booking_date).toLocaleString('en-GB') %>
                        </p>

                        <span class="status">
                            Booking Confirmed
                        </span>

                        <div class="actions">

                            <a href="/learner/edit_booking/<%= booking.id %>" class="edit-btn">
                                Edit Booking
                            </a>

                            <a href="/learner/cancel/<%= booking.id %>" class="cancel-btn"
                                onclick="return confirmCancellation();">
                                Cancel Booking
                            </a>

                        </div>

                    </div>

                    <% }); %>

                        <% } %>

    </div>

    <script>

        function confirmCancellation() {

            return confirm(
                "Cancellation is being processed.\n\nRefund for payment made will be successful in 3-5 business days.\n\nClick OK to continue."
            );

        }

    </script>

</body>

</html>