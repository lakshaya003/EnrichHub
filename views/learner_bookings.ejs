<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Learner Bookings | EnrichHub</title>

    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: Arial, Helvetica, sans-serif;
        }

        body {
            background: #f4f6fb;
        }

        .sidebar {
            position: fixed;
            width: 250px;
            height: 100vh;
            background: #0f4674b5;
            padding-top: 30px;
        }

        .sidebar h2 {
            color: white;
            text-align: center;
            margin-bottom: 30px;
        }

        .sidebar a {
            display: block;
            color: white;
            text-decoration: none;
            padding: 15px 25px;
            transition: 0.3s;
        }

        .sidebar a:hover {
            background: rgba(255, 255, 255, 0.15);
        }

        .sidebar a.active {
            background: white;
            color: #0f4674b5;
            font-weight: bold;
            border-left: 5px solid #fbbf24;
        }

        .main {
            margin-left: 250px;
            padding: 30px;
        }

        .header {
            margin-bottom: 30px;
        }

        .header h1 {
            color: #0f4674;
            margin-bottom: 10px;
        }

        .header p {
            color: #666;
        }

        .back-btn {
            display: inline-block;
            margin-bottom: 20px;
            background: #0f4674b5;
            color: white;
            text-decoration: none;
            padding: 10px 18px;
            border-radius: 8px;
            font-weight: bold;
        }

        .back-btn:hover {
            opacity: 0.9;
        }

        .stats {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
            gap: 20px;
            margin-bottom: 30px;
        }

        .stat-card {
            background: white;
            padding: 25px;
            border-radius: 16px;
            text-align: center;
            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.08);
        }

        .stat-card h2 {
            color: #0f4674;
            font-size: 30px;
            margin-bottom: 8px;
        }

        .stat-card p {
            color: #666;
        }

        .bookings-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(420px, 1fr));
            gap: 25px;
        }

        .booking-card {
            background: white;
            border-radius: 18px;
            padding: 25px;
            box-shadow: 0 5px 18px rgba(0, 0, 0, 0.08);
            transition: all 0.3s ease;
        }

        .booking-card:hover {
            transform: translateY(-6px);
            box-shadow: 0 10px 30px rgba(15, 70, 116, 0.18);
        }

        .booking-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 18px;
        }

        .booking-header h3 {
            color: #0f4674;
        }

        .ticket-badge {
            background: #e8f1f8;
            color: #0f4674;
            padding: 6px 12px;
            border-radius: 20px;
            font-size: 13px;
            font-weight: bold;
        }

        .details-grid {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 15px;
        }

        .detail-box {
            background: #f8fafc;
            padding: 12px;
            border-radius: 10px;
        }

        .detail-box strong {
            display: block;
            color: #555;
            margin-bottom: 5px;
            font-size: 13px;
        }

        .detail-box span {
            color: #222;
        }

        .empty-message {
            color: #666;
            font-style: italic;
        }

        .sidebar-brand {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 0 20px;
            margin-bottom: 30px;
        }

        .sidebar-logo {
            width: 60px;
            height: 60px;
            border-radius: 50%;
            object-fit: cover;
        }

        .sidebar-brand h2 {
            color: white;
            margin: 0;
            font-size: 24px;
        }
    </style>

</head>

<body>

    <div class="sidebar">

        <div class="sidebar-brand">

            <img src="/logo.png" alt="EnrichHub Logo" class="sidebar-logo">

            <h2 onclick="location.href='/organiser'" style="cursor:pointer;">
                EnrichHub
            </h2>

        </div>

        <a href="/organiser">
            Dashboard
        </a>

        <a href="/organiser/create_new_course">
            Create New Course
        </a>

        <a href="/organiser/published">
            Published Courses
        </a>

        <a href="/organiser/edit_course">
            Draft Courses
        </a>

        <a href="/organiser/bookings" class="<%= activePage === 'bookings' ? 'active' : '' %>">
            Learner Bookings
        </a>

        <a href="/organiser/analytics">
            Analytics
        </a>

        <a href="/organiser/site_settings">
            Site Settings
        </a>

    </div>

    <div class="main">

        <a href="/organiser" class="back-btn">
            Back to Dashboard
        </a>

        <div class="header">

            <h1>Learner Bookings</h1>

            <p>
                View all learner registrations and ticket purchases.
            </p>

        </div>
        <div class="stats">

            <div class="stat-card">
                <h2>
                    <%= bookings.length %>
                </h2>
                <p>Total Bookings</p>
            </div>

            <div class="stat-card">
                <h2>
                    <%= [...new Set(bookings.map(b=> b.email))].length %>
                </h2>
                <p>Unique Learners</p>
            </div>

        </div>

        <% if(bookings.length===0){ %>

            <div class="section">
                <p class="empty-message">
                    No bookings yet.
                </p>
            </div>

            <% } else { %>

                <div class="bookings-grid">

                    <% bookings.forEach(booking=> { %>

                        <div class="booking-card">

                            <div class="booking-header">

                                <h3>
                                    <%= booking.learner_name %>
                                </h3>

                                <span class="ticket-badge">
                                    <%= booking.ticket_type %>
                                </span>

                            </div>

                            <div class="details-grid">

                                <div class="detail-box">
                                    <strong>Course</strong>
                                    <span>
                                        <%= booking.title %>
                                    </span>
                                </div>

                                <div class="detail-box">
                                    <strong>Email</strong>
                                    <span>
                                        <%= booking.email %>
                                    </span>
                                </div>

                                <div class="detail-box">
                                    <strong>Ticket Type</strong>
                                    <span>
                                        <%= booking.ticket_type %>
                                    </span>
                                </div>

                                <div class="detail-box">
                                    <strong>Quantity</strong>
                                    <span>
                                        <%= booking.quantity %>
                                    </span>
                                </div>

                                <div class="detail-box">
                                    <strong>Booking Date</strong>
                                    <span>
                                        <%= new Date(booking.booking_date).toLocaleDateString('en-GB') %>
                                    </span>
                                </div>

                                <div class="detail-box">
                                    <strong>Booking Time</strong>
                                    <span>
                                        <%= new Date(booking.booking_date).toLocaleTimeString('en-GB') %>
                                    </span>
                                </div>

                            </div>

                        </div>

                        <% }) %>

                </div>

                <% } %>

    </div>

</body>

</html>