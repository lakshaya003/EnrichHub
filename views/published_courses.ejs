<!DOCTYPE html>
<html>

<head>
    <title>Published Courses | EnrichHub</title>

    <style>
        body {
            font-family: Arial, sans-serif;
            background: #f4f6fb;
            margin: 0;
        }

        .main {
            margin-left: 250px;
            padding: 40px;
        }

        .page-title {
            color: #0f4674;
            margin-bottom: 25px;
        }

        .course-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(450px, 1fr));
            gap: 25px;
        }

        .card {
            background: white;
            border-radius: 18px;
            padding: 25px;
            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.08);
            transition: all 0.3s ease;
            border-top: 5px solid #0f4674b5;
        }

        .card:hover {
            transform: translateY(-8px);
            box-shadow: 0 12px 25px rgba(0, 0, 0, 0.15);
        }

        .card h2 {
            color: #0f4674;
            margin-bottom: 15px;
        }

        .description {
            color: #444;
            line-height: 1.6;
            margin-bottom: 20px;
        }

        .details-grid {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 12px;
            margin-top: 15px;
        }

        .detail-box {
            background: #f8fafc;
            padding: 12px;
            border-radius: 10px;
        }

        .detail-box strong {
            display: block;
            color: #0f4674;
            margin-bottom: 4px;
        }

        .status-badge {
            display: inline-block;
            background: #dcfce7;
            color: #166534;
            padding: 8px 14px;
            border-radius: 20px;
            font-size: 13px;
            font-weight: bold;
            margin-bottom: 15px;
        }

        .actions {
            margin-top: 25px;
            display: flex;
            gap: 10px;
        }

        .btn {
            background: #0f4674b5;
            color: white;
            padding: 10px 18px;
            border-radius: 8px;
            text-decoration: none;
            font-weight: bold;
            transition: 0.3s;
        }

        .btn:hover {
            background: #0f4674;
        }

        .delete-btn {
            background: #ef4444;
            color: white;
            padding: 10px 18px;
            border-radius: 8px;
            text-decoration: none;
            font-weight: bold;
            transition: 0.3s;
        }

        .delete-btn:hover {
            background: #dc2626;
        }

        .empty-state {
            background: white;
            padding: 40px;
            border-radius: 15px;
            text-align: center;
            margin-top: 20px;
        }

        .sidebar {
            position: fixed;
            width: 250px;
            height: 100vh;
            background: #0f4674b5;
            padding-top: 30px;
        }

        .sidebar a.active {
            background: white;
            color: #0f4674b5;
            font-weight: bold;
            border-left: 5px solid #fbbf24;
        }

        .sidebar h2 {
            color: white;
            text-align: center;
            margin-bottom: 30px;
        }

        .sidebar a {
            display: block;
            color: white;
            text-decoration: none;
            padding: 15px 25px;
            transition: 0.3s;
        }

        .sidebar a:hover {
            background: rgba(255, 255, 255, 0.15);
        }

        .back-btn {
            display: inline-block;
            margin-bottom: 20px;
            background: #0f4674b5;
            color: white;
            text-decoration: none;
            padding: 10px 18px;
            border-radius: 8px;
            font-weight: bold;
        }

        .back-btn:hover {
            opacity: 0.9;
        }

        .status {
            color: green;
            font-weight: bold;
        }

        .sold-out {
            background: #ef4444;
            color: white;
            padding: 6px 12px;
            border-radius: 20px;
            font-size: 12px;
            font-weight: bold;
        }

        .sidebar-brand {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 0 20px;
            margin-bottom: 30px;
        }

        .sidebar-logo {
            width: 60px;
            height: 60px;
            border-radius: 50%;
            object-fit: cover;
        }

        .sidebar-brand h2 {
            color: white;
            margin: 0;
            font-size: 24px;
        }
    </style>

</head>

<body>

    <div class="sidebar">
        <div class="sidebar-brand">

            <img src="/logo.png" alt="EnrichHub Logo" class="sidebar-logo">

            <h2 onclick="location.href='/organiser'" style="cursor:pointer;">
                EnrichHub
            </h2>

        </div>

        <a href="/organiser">Dashboard</a>
        <a href="/organiser/create_new_course">Create New Course</a>
        <a href="/organiser/published" class="<%= activePage === 'published' ? 'active' : '' %>">
            Published Courses
        </a>
        <a href="/organiser/edit_course">Draft Courses</a>
        <a href="/organiser/bookings">Learner Bookings</a>
        <a href="/organiser/analytics">Analytics</a>
        <a href="/organiser/site_settings"> Site Settings</a>
    </div>

    <div class="main">

        <a href="/organiser" class="back-btn">
            ← Back to Dashboard
        </a>

        <h1 class="page-title">
            Published Courses
        </h1>

        <% if(events.length===0){ %>

            <div class="empty-state">
                <h2>No Published Courses</h2>
                <br>
                <p>You haven't published any courses yet.</p>
            </div>

            <% } else { %>

                <div class="course-grid">

                    <% events.forEach(event=> { %>

                        <div class="card">

                            <span class="status-badge">
                                ✓ Published
                            </span>

                            <h2>
                                <%= event.title %>
                            </h2>

                            <p class="description">
                                <%= event.description %>
                            </p>

                            <div class="details-grid">

                                <div class="detail-box">
                                    <strong>Category</strong>
                                    <%= event.category %>
                                </div>

                                <div class="detail-box">
                                    <strong>Age Group</strong>
                                    <%= event.age_group %>
                                </div>

                                <div class="detail-box">
                                    <strong>Course Date</strong>
                                    <%= new Date(event.event_date).toLocaleDateString('en-GB') %>
                                </div>

                                <div class="detail-box">
                                    <strong>Venue</strong>
                                    <%= event.venue %>
                                </div>

                                <div class="detail-box">
                                    <strong>Capacity</strong>
                                    <%= event.capacity %>
                                </div>

                                <div class="detail-box" style="grid-column: span 2;">

                                    <strong>💰 Ticket Pricing</strong>

                                    <div style="
                                        display:flex;
                                        gap:10px;
                                        margin-top:10px;
                                    ">

                                        <div style="
                                            flex:1;
                                            background:#eaf4ff;
                                            padding:12px;
                                            border-radius:8px;
                                            text-align:center;
                                        ">

                                            <div style="
                                                font-size:12px;
                                                color:#0f4674;
                                                font-weight:bold;
                                                margin-bottom:5px;
                                            ">
                                                Full Ticket
                                            </div>

                                            <div style="
                                                font-size:22px;
                                                font-weight:bold;
                                                color:#0f4674;
                                            ">
                                                $<%= Number(event.full_ticket_price).toFixed(2) %>
                                            </div>

                                        </div>

                                        <div style="
                                            flex:1;
                                            background:#fef3c7;
                                            padding:12px;
                                            border-radius:8px;
                                            text-align:center;
                                        ">

                                            <div style="
                                                font-size:12px;
                                                color:#92400e;
                                                font-weight:bold;
                                                margin-bottom:5px;
                                            ">
                                                Concession Ticket
                                            </div>

                                            <div style="
                                                font-size:22px;
                                                font-weight:bold;
                                                color:#92400e;
                                            ">
                                                $<%= Number(event.concession_ticket_price).toFixed(2) %>
                                            </div>

                                        </div>

                                    </div>

                                </div>

                                <div class="detail-box">
                                    <strong>Full Tickets</strong>

                                    <span>
                                        <%= event.full_tickets_left %> / <%= event.full_ticket_qty %> remaining
                                    </span>

                                    <br>

                                    <small>
                                        Sold:
                                        <%= event.full_ticket_qty - event.full_tickets_left %>
                                    </small>
                                </div>

                                <div class="detail-box">
                                    <strong>Concession Tickets</strong>

                                    <span>
                                        <%= event.concession_tickets_left %> / <%= event.concession_ticket_qty %>
                                                remaining
                                    </span>

                                    <br>

                                    <small>
                                        Sold:
                                        <%= event.concession_ticket_qty - event.concession_tickets_left %>
                                    </small>
                                </div>

                                <div class="detail-box">
                                    <strong>Created On</strong>
                                    <%= new Date(event.created_at).toLocaleString('en-GB') %>
                                </div>

                                <div class="detail-box">
                                    <strong>Published On</strong>
                                    <%= event.published_at ? new Date(event.published_at).toLocaleString('en-GB')
                                        : 'N/A' %>
                                </div>

                            </div>

                            <div class="actions">

                                <a href="/learner/course/<%= event.id %>" class="btn">
                                    View Learner Page
                                </a>

                                <a href="/organiser/edit_course/<%= event.id %>" class="btn">
                                    Edit Course
                                </a>

                                <a href="/organiser/delete/<%= event.id %>" class="delete-btn"
                                    onclick="return confirm('Delete this course?')">
                                    Delete
                                </a>

                            </div>

                        </div>

                        <% }) %>

                </div>

                <% } %>

    </div>

</body>

</html>