<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>EnrichHub Organiser Dashboard</title>

    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: Arial, Helvetica, sans-serif;
        }

        body {
            background: #f4f6fb;
        }

        .sidebar {
            position: fixed;
            width: 250px;
            height: 100vh;
            background: #0f4674b5;
            padding-top: 30px;
        }

        .sidebar a.active {
            background: white;
            color: #0f4674b5;
            font-weight: bold;
            border-left: 5px solid #fbbf24;
        }

        .sidebar h2 {
            color: white;
            text-align: center;
            margin-bottom: 30px;
        }

        .sidebar a {
            display: block;
            color: white;
            text-decoration: none;
            padding: 15px 25px;
            transition: 0.3s;
        }

        .sidebar a:hover {
            background: rgba(255, 255, 255, 0.15);
        }

        .main {
            margin-left: 250px;
            padding: 30px;
        }

        .header {
            margin-bottom: 30px;
        }

        .header h1 {
            color: #0b061c9e;
        }

        .stats {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
            gap: 20px;
            margin-bottom: 35px;
        }

        .card {
            background: white;
            padding: 25px;
            border-radius: 18px;
            text-align: center;
            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.08);
            transition: all 0.3s ease;
        }

        .card:hover {
            transform: translateY(-6px);
            box-shadow: 0 12px 25px rgba(0, 0, 0, 0.12);
        }

        .card h2 {
            font-size: 36px;
            color: #0f4674;
            margin-bottom: 10px;
        }

        .card p {
            color: #666;
            font-weight: 600;
        }

        .section {
            background: white;
            padding: 30px;
            border-radius: 20px;
            margin-bottom: 35px;
            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.08);
        }

        .section h2 {
            margin-bottom: 25px;
            color: #222;
        }

        .course-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(420px, 1fr));
            gap: 25px;
        }

        .course-card {
            background: #fff;
            border-radius: 18px;
            padding: 25px;
            border: 1px solid #e5e7eb;
            transition: all 0.3s ease;
        }

        .course-card:hover {
            transform: translateY(-6px);
            box-shadow: 0 12px 25px rgba(0, 0, 0, 0.12);
        }

        .course-card h3 {
            color: #0f4674;
            margin-bottom: 15px;
        }

        .details-grid {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 12px;
            margin-top: 15px;
            margin-bottom: 20px;
        }

        .detail-box {
            background: #f8fafc;
            padding: 12px;
            border-radius: 10px;
        }

        .detail-box strong {
            display: block;
            margin-bottom: 5px;
            color: #555;
            font-size: 13px;
        }

        .status-badge {
            display: inline-block;
            padding: 6px 14px;
            border-radius: 999px;
            font-size: 13px;
            font-weight: bold;
            margin-bottom: 15px;
        }

        .status-published {
            background: #dcfce7;
            color: #166534;
        }

        .status-draft {
            background: #fef3c7;
            color: #92400e;
        }

        .action-buttons {
            display: flex;
            flex-wrap: wrap;
            gap: 10px;
            margin-top: 15px;
        }

        .btn {
            display: inline-block;
            background: #0f4674b5;
            color: white;
            padding: 10px 20px;
            border-radius: 8px;
            text-decoration: none;
            margin-top: 15px;
        }

        .top-actions {
            margin-bottom: 20px;
        }

        .home-btn {
            display: inline-block;
            background: #3c387ce7;
            color: white;
            text-decoration: none;
            padding: 10px 20px;
            border-radius: 8px;
            font-weight: bold;
            transition: 0.3s;
        }

        .home-btn:hover {
            opacity: 0.9;
        }

        .publish-btn {
            display: inline-block;
            background: #10b981;
            color: white;
            padding: 10px 20px;
            border-radius: 8px;
            text-decoration: none;
            margin-top: 15px;
            margin-left: 8px;
        }

        .publish-btn:hover {
            background: #059669;
        }

        .delete-btn {
            display: inline-block;
            margin-top: 15px;
            background: #ef4444;
            color: white;
            text-decoration: none;
            padding: 10px 16px;
            border-radius: 8px;
            font-weight: bold;
        }

        .delete-btn:hover {
            background: #dc2626;
        }

        .stat-link {
            text-decoration: none;
            color: inherit;
            display: block;
        }

        .stat-link .card {
            cursor: pointer;
        }

        .sidebar-brand {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 0 20px;
            margin-bottom: 30px;
        }

        .sidebar-logo {
            width: 60px;
            height: 60px;
            border-radius: 50%;
            object-fit: cover;
        }

        .sidebar-brand h2 {
            color: white;
            margin: 0;
            font-size: 24px;
        }
    </style>
</head>

<body>

    <div class="sidebar">

        <div class="sidebar-brand">

            <img src="/logo.png" alt="EnrichHub Logo" class="sidebar-logo">

            <h2>EnrichHub</h2>

        </div>

        <a href="/organiser" class="<%= activePage === 'dashboard' ? 'active' : '' %>">
            Dashboard
        </a>

        <a href="/organiser/create_new_course" class="<%= activePage === 'create' ? 'active' : '' %>">
            Create New Course
        </a>

        <a href="/organiser/published" class="<%= activePage === 'published' ? 'active' : '' %>">
            Published Courses
        </a>

        <a href="/organiser/edit_course" class="<%= activePage === 'drafts' ? 'active' : '' %>">
            Draft Courses
        </a>

        <a href="/organiser/bookings" class="<%= activePage === 'bookings' ? 'active' : '' %>">
            Learner Bookings
        </a>

        <a href="/organiser/analytics" class="<%= activePage === 'analytics' ? 'active' : '' %>">
            Analytics
        </a>

        <a href="/organiser/site_settings" class="<%= activePage === 'site_settings' ? 'active' : '' %>">
            Site Settings
        </a>

    </div>

    <div class="main">

        <div class="top-actions">

            <a href="/" class="home-btn">
                ← Return to Home Page
            </a>

        </div>

        <div class="header">

            <h1>
                <%= settings.site_name %>
            </h1>

            <p>
                <%= settings.description %>
            </p>

        </div>

        <div class="stats">

            <a href="/organiser/bookings" class="stat-link">
                <div class="card">
                    <h2>
                        <%= totalLearners %>
                    </h2>
                    <p>Total Learners</p>
                </div>
            </a>

            <a href="/organiser/published" class="stat-link">
                <div class="card">
                    <h2>
                        <%= publishedEvents.length %>
                    </h2>
                    <p>Published Courses</p>
                </div>
            </a>

            <a href="/organiser/edit_course" class="stat-link">
                <div class="card">
                    <h2>
                        <%= draftEvents.length %>
                    </h2>
                    <p>Draft Courses</p>
                </div>
            </a>

        </div>


        <div class="section">

            <h2>Published Courses</h2>

            <% if(publishedEvents.length===0){ %>

                <p>No published courses.</p>

                <% } else { %>

                    <div class="course-grid">

                        <% publishedEvents.forEach(event=> { %>

                            <div class="course-card">

                                <span class="status-badge status-published">
                                    Published
                                </span>

                                <h3>
                                    <%= event.title %>
                                </h3>

                                <div class="details-grid">

                                    <div class="detail-box">
                                        <strong>Course Date</strong>
                                        <%= event.event_date ? new Date(event.event_date).toLocaleDateString('en-GB')
                                            : 'Not Set' %>
                                    </div>

                                    <div class="detail-box">
                                        <strong>Created On</strong>
                                        <%= new Date(event.created_at).toLocaleString('en-GB') %>
                                    </div>

                                    <div class="detail-box">
                                        <strong>Published On</strong>
                                        <%= event.published_at ? new Date(event.published_at).toLocaleString('en-GB')
                                            : 'N/A' %>
                                    </div>

                                    <div class="detail-box">
                                        <strong>Full Tickets</strong>
                                        <%= event.full_ticket_qty %>
                                    </div>

                                    <div class="detail-box">
                                        <strong>Concession Tickets</strong>
                                        <%= event.concession_ticket_qty %>
                                    </div>

                                </div>

                                <div class="action-buttons">

                                    <a href="/learner/course/<%= event.id %>" class="btn">
                                        View Learner Page
                                    </a>

                                    <a href="/organiser/edit_course/<%= event.id %>" class="btn">
                                        Edit
                                    </a>

                                    <a href="/organiser/delete/<%= event.id %>" class="delete-btn"
                                        onclick="return confirm('Delete this event?')">
                                        Delete
                                    </a>

                                </div>

                            </div>

                            <% }) %>

                    </div>

                    <% } %>

        </div>

        <div class="section">

            <h2>Draft Courses</h2>

            <% if(draftEvents.length===0){ %>

                <p>No draft courses.</p>

                <% } else { %>

                    <div class="course-grid">

                        <% draftEvents.forEach(event=> { %>

                            <div class="course-card">

                                <span class="status-badge status-draft">
                                    Draft
                                </span>

                                <h3>
                                    <%= event.title %>
                                </h3>

                                <div class="details-grid">

                                    <div class="detail-box">
                                        <strong>Course Date</strong>
                                        <%= new Date(event.event_date).toLocaleDateString('en-GB') %>
                                    </div>

                                    <div class="detail-box">
                                        <strong>Created On</strong>
                                        <%= new Date(event.created_at).toLocaleString('en-GB') %>
                                    </div>

                                    <div class="detail-box">
                                        <strong>Last Modified</strong>
                                        <%= event.modified_at ? new Date(event.modified_at).toLocaleString('en-GB')
                                            : 'Never Modified' %>
                                    </div>

                                    <div class="detail-box">
                                        <strong>Full Tickets</strong>
                                        <%= event.full_ticket_qty %>
                                    </div>

                                    <div class="detail-box">
                                        <strong>Concession Tickets</strong>
                                        <%= event.concession_ticket_qty %>
                                    </div>

                                </div>

                                <div class="action-buttons">

                                    <a href="/organiser/edit_course/<%= event.id %>" class="btn">
                                        Edit
                                    </a>

                                    <a href="/organiser/publish/<%= event.id %>" class="publish-btn">
                                        Publish
                                    </a>

                                    <a href="/organiser/delete/<%= event.id %>" class="delete-btn"
                                        onclick="return confirm('Delete this event?')">
                                        Delete
                                    </a>

                                </div>

                            </div>

                            <% }) %>

                    </div>

                    <% } %>

        </div>
</body>

</html>