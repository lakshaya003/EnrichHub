<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Edit Event | EnrichHub</title>

    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: Arial, Helvetica, sans-serif;
        }

        body {
            background: #f4f6fb;
        }

        .sidebar {
            position: fixed;
            width: 250px;
            height: 100vh;
            background: #0f4674b5;
            padding-top: 30px;
        }

        .sidebar h2 {
            color: white;
            text-align: center;
            margin-bottom: 30px;
        }

        .sidebar a {
            display: block;
            padding: 15px 25px;
            text-decoration: none;
            color: white;
        }

        .sidebar a.active {
            background: white;
            color: #0f4674b5;
            font-weight: bold;
            border-left: 5px solid #fbbf24;
        }

        .sidebar a:hover {
            background: rgba(255, 255, 255, .15);
        }

        .main {
            margin-left: 250px;
            padding: 40px;
        }

        .page-header {
            margin-bottom: 30px;
        }

        .page-header h1 {
            color: #222;
            margin-bottom: 10px;
        }

        .page-header p {
            color: #666;
        }

        .form-card {
            background: white;
            padding: 40px;
            border-radius: 20px;
            box-shadow: 0 8px 20px rgba(0, 0, 0, .08);
            max-width: 1000px;
        }

        .section-title {
            color: #0f4674;
            margin-bottom: 20px;
            padding-bottom: 10px;
            border-bottom: 2px solid #eef2f7;
        }

        .form-grid {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 20px;
        }

        .form-group {
            margin-bottom: 20px;
        }

        .form-group.full-width {
            grid-column: span 2;
        }

        label {
            display: block;
            margin-bottom: 8px;
            font-weight: bold;
            color: #222;
        }

        input,
        textarea,
        select {
            width: 100%;
            padding: 14px;
            border: 1px solid #d9dee7;
            border-radius: 10px;
            transition: 0.3s;
            font-size: 15px;
        }

        input:focus,
        textarea:focus,
        select:focus {
            outline: none;
            border-color: #0f4674;
            box-shadow: 0 0 0 3px rgba(15, 70, 116, .12);
        }

        textarea {
            min-height: 130px;
            resize: vertical;
        }

        .info-box {
            background: #f8fafc;
            border-left: 5px solid #0f4674;
            padding: 18px;
            border-radius: 10px;
            margin-bottom: 30px;
        }

        .ticket-section {
            margin-top: 35px;
        }

        .action-bar {
            margin-top: 35px;
        }

        .btn {
            background: #0f4674;
            color: white;
            border: none;
            padding: 14px 24px;
            border-radius: 10px;
            cursor: pointer;
            font-weight: bold;
            transition: 0.3s;
        }

        .btn:hover {
            transform: translateY(-2px);
        }

        .publish-btn {
            background: #10b981;
            margin-left: 10px;
        }

        .publish-btn:hover {
            background: #059669;
        }

        .status-badge {
            display: inline-block;
            background: #fef3c7;
            color: #92400e;
            padding: 8px 14px;
            border-radius: 20px;
            font-size: 13px;
            font-weight: bold;
            margin-bottom: 20px;
        }

        .back-btn {
            display: inline-block;
            margin-bottom: 20px;
            background: #0f4674b5;
            color: white;
            text-decoration: none;
            padding: 10px 18px;
            border-radius: 8px;
        }
    </style>

</head>

<body>

    <div class="sidebar">

        <h2 onclick="location.href='/organiser'" style="cursor:pointer;">
            EnrichHub
        </h2>

        <a href="/organiser">Dashboard</a>
        <a href="/organiser/create_new_course">Create New Course</a>
        <a href="/organiser/published">Published Courses</a>
        <a href="/organiser/edit_course" class="<%= activePage === 'drafts' ? 'active' : '' %>">
            Draft Courses
        </a>

        <a href="/organiser/bookings">Learner Bookings</a>
        <a href="/organiser/analytics">Analytics</a>
        <a href="/organiser/site_settings">Site Settings</a>

    </div>

    <div class="main">

        <a href="/organiser" class="back-btn">
            Back to Dashboard
        </a>

        <div class="page-header">

            <h1>Organizer Edit Course</h1>

            <p>
                Create and amend course by inputing required course details, ticket information and publication
                settings.
            </p>

        </div>

        <span class="status-badge">
            <%= event.status ? event.status.toUpperCase() : 'DRAFT' %>
        </span>


        <div class="form-card">

            <form action="/organiser/edit_course/<%= event.id %>" method="POST">

                <div class="info-box">
                    Modify course information below. Changes can be saved as a draft
                    or published immediately for learners to view and book.
                </div>

                <h2 class="section-title">
                    Course Information
                </h2>

                <!-- Course Title -->
                <div class="form-group">
                    <label>Course Title</label>
                    <input type="text" name="title" value="<%= event.title %>" required>
                </div>

                <!-- Description -->
                <div class="form-group">
                    <label>Description</label>
                    <textarea name="description" required><%= event.description %></textarea>
                </div>

                <!-- Two-column grid -->
                <div class="form-grid">

                    <div class="form-group">
                        <label>Category</label>
                        <select name="category">

                            <option value="Technology" <%=event.category==='Technology' ? 'selected' : '' %>>
                                Technology
                            </option>

                            <option value="Arts" <%=event.category==='Arts' ? 'selected' : '' %>>
                                Arts
                            </option>

                            <option value="Music" <%=event.category==='Music' ? 'selected' : '' %>>
                                Music
                            </option>

                            <option value="Sports" <%=event.category==='Sports' ? 'selected' : '' %>>
                                Sports
                            </option>

                            <option value="Science" <%=event.category==='Science' ? 'selected' : '' %>>
                                Science
                            </option>

                            <option value="Language" <%=event.category==='Language' ? 'selected' : '' %>>
                                Language
                            </option>

                            <option value="Language" <%=event.category==='Heritage' ? 'selected' : '' %>>
                                Heritage
                            </option>

                            <option value="Language" <%=event.category==='Heritage' ? 'selected' : '' %>>
                                Food
                            </option>


                        </select>
                    </div>

                    <div class="form-group">
                        <label>Age Group</label>
                        <select name="age_group">

                            <option value="Children (8-11)" <%=event.age_group==='Children (8-11)' ? 'selected' : '' %>>
                                Children (8-11)
                            </option>

                            <option value="Teens (12-16)" <%=event.age_group==='Teens (12-16)' ? 'selected' : '' %>>
                                Teens (12-16)
                            </option>

                            <option value="Young Adults (17-21)" <%=event.age_group==='Young Adults (17-21)'
                                ? 'selected' : '' %>>
                                Young Adults (17-21)
                            </option>

                            <option value="Adults (22-45)" <%=event.age_group==='Adults (22-45)' ? 'selected' : '' %>>
                                Adults (22-45)
                            </option>

                            <option value="Seniors (50-65)" <%=event.age_group==='Seniors (50-65)' ? 'selected' : '' %>>
                                Seniors (50-65)
                            </option>

                        </select>
                    </div>

                    <div class="form-group">
                        <label>Venue</label>
                        <input type="text" name="venue" value="<%= event.venue %>">
                    </div>

                    <div class="form-group">
                        <label>Capacity</label>
                        <input type="number" name="capacity" value="<%= event.capacity %>">
                    </div>

                    <div class="form-group">
                        <label>Event Date</label>
                        <input type="date" name="event_date" value="<%= event.event_date %>">
                    </div>

                </div>

                <h2 class="section-title">
                    Ticket Information
                </h2>

                <div class="form-grid">

                    <div class="form-group">
                        <label>Full Ticket Quantity</label>
                        <input type="number" name="full_ticket_qty" value="<%= event.full_ticket_qty %>">
                    </div>

                    <div class="form-group">
                        <label>Full Ticket Price ($)</label>
                        <input type="number" step="0.01" name="full_ticket_price"
                            value="<%= event.full_ticket_price %>">
                    </div>

                    <div class="form-group">
                        <label>Concession Ticket Quantity</label>
                        <input type="number" name="concession_ticket_qty" value="<%= event.concession_ticket_qty %>">
                    </div>

                    <div class="form-group">
                        <label>Concession Ticket Price ($)</label>
                        <input type="number" step="0.01" name="concession_ticket_price"
                            value="<%= event.concession_ticket_price %>">
                    </div>

                </div>

                <div class="button-group">
                    <button type="submit" name="action" value="save" class="btn">
                        Save as Draft
                    </button>

                    <button type="submit" name="action" value="publish" class="btn publish-btn">
                        Publish Course
                    </button>
                </div>

            </form>

        </div>

    </div>

</body>

</html>