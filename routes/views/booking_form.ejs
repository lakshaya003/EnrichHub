<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Book Course | EnrichHub</title>

    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: Arial, Helvetica, sans-serif;
        }

        body {
            background: #f4f6fb;
        }

        .sidebar {
            position: fixed;
            width: 250px;
            height: 100vh;
            background: #35503f9d;
            padding-top: 30px;
        }

        .sidebar h2 {
            color: white;
            text-align: center;
            margin-bottom: 30px;
        }

        .sidebar a {
            display: block;
            color: white;
            text-decoration: none;
            padding: 15px 25px;
        }

        .sidebar a.active {
            background: white;
            color: #35503f;
            font-weight: bold;
            border-left: 5px solid #fbbf24;
        }

        .sidebar a:hover {
            background: rgba(255, 255, 255, 0.15);
        }

        .main {
            margin-left: 250px;
            padding: 40px;
        }

        .back-btn {
            display: inline-block;
            margin-bottom: 20px;
            background: #35503f9d;
            color: white;
            text-decoration: none;
            padding: 10px 18px;
            border-radius: 8px;
            font-weight: bold;
        }

        .back-btn:hover {
            opacity: 0.9;
        }

        .booking-card {
            max-width: 850px;
            background: white;
            padding: 30px;
            border-radius: 15px;
            box-shadow: 0 2px 10px rgba(0, 0, 0, .1);
        }

        .booking-card h1 {
            color: #35503f;
            margin-bottom: 20px;
        }

        .course-info {
            background: #f8f9fa;
            padding: 20px;
            border-radius: 10px;
            margin-bottom: 25px;
        }

        .course-info p {
            margin-bottom: 10px;
        }

        .course-info strong {
            color: #35503f;
        }


        .form-group {
            margin-bottom: 20px;
        }

        label {
            display: block;
            margin-bottom: 8px;
            font-weight: bold;
            color: #333;
        }

        input,
        select {
            width: 100%;
            padding: 12px;
            border: 1px solid #ddd;
            border-radius: 8px;
            font-size: 15px;
        }

        input:focus,
        select:focus {
            outline: none;
            border-color: #35503f9d;
        }

        .btn {
            background: #10b981;
            color: white;
            border: none;
            padding: 14px 25px;
            border-radius: 8px;
            cursor: pointer;
            font-size: 16px;
            font-weight: bold;
        }

        .btn:hover {
            background: #059669;
        }

        .section-title {
            color: #35503f;
            margin-bottom: 15px;
        }

        .error-banner {
            background: #fee2e2;
            color: #b91c1c;
            border: 1px solid #fca5a5;
            padding: 14px;
            border-radius: 8px;
            margin-bottom: 20px;
            font-weight: bold;
        }


        .availability-box {
            display: flex;
            gap: 15px;
            margin-bottom: 25px;
        }

        .availability-box div {
            flex: 1;
            background: #f8fafc;
            padding: 15px;
            border-radius: 10px;
            border-left: 5px solid #10b981;
            font-weight: bold;
        }

        .summary-box {
            background: #f8fafc;
            padding: 20px;
            border-radius: 10px;
            margin-bottom: 20px;
        }

        .summary-box h3 {
            color: #35503f;
            margin-bottom: 10px;
        }

        .summary-box p {
            margin-bottom: 8px;
        }

        .sidebar-brand {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 0 20px;
            margin-bottom: 30px;
        }

        .sidebar-logo {
            width: 60px;
            height: 60px;
            border-radius: 50%;
            object-fit: cover;
        }

        .sidebar-brand h2 {
            color: white;
            margin: 0;
            font-size: 24px;
        }
    </style>

</head>

<body>

    <div class="sidebar">

        <div class="sidebar-brand">

            <img src="/logo.png" alt="EnrichHub Logo" class="sidebar-logo">

            <h2 onclick="location.href='/learner'" style="cursor:pointer;">
                EnrichHub
            </h2>

        </div>

        <a href="/learner">
            Learner Dashboard
        </a>

        <a href="/learner/courses">
            Browse Courses
        </a>

        <a href="/learner/bookings">
            My Bookings
        </a>

        <a href="/learner/profile">
            My Profile
        </a>

    </div>

    <div class="main">

        <a href="/learner/course/<%= event.id %>" class="back-btn">
            ← Back to Course Details
        </a>

        <div class="booking-card">

            <h1>Course Booking Form</h1>


            <div class="course-info">

                <h3 class="section-title">Course Information</h3>

                <p>
                    <strong>Course:</strong>
                    <%= event.title %>
                </p>

                <p>
                    <strong>Category:</strong>
                    <%= event.category %>
                </p>

                <p>
                    <strong>Venue:</strong>
                    <%= event.venue %>
                </p>

                <p>
                    <strong>Course Date:</strong>
                    <%= new Date(event.event_date).toLocaleDateString('en-GB') %>
                </p>

            </div>

            <div class="availability-box">

                <div>
                    <strong>Full Tickets</strong><br>
                    Sold: <%= event.full_tickets_sold %><br>
                        Left: <%= event.full_tickets_left %>/<%= event.full_ticket_qty %>
                </div>

                <div>
                    <strong>Concession Tickets</strong><br>
                    Sold: <%= event.concession_tickets_sold %><br>
                        Left: <%= event.concession_tickets_left %>/<%= event.concession_ticket_qty %>
                </div>

            </div>

            <% if (typeof error !=='undefined' && error) { %>
                <div class="error-banner">
                    <%= error %>
                </div>
                <% } %>

                    <form action="/learner/book/<%= event.id %>" method="POST">

                        <div class="form-group">
                            <label>Learner Name</label>
                            <input type="text" name="learner_name" placeholder="Enter learner name" required>
                        </div>

                        <div class="form-group">
                            <label>Email Address</label>
                            <input type="email" name="email" placeholder="Enter email address" required>
                        </div>

                        <div class="form-group">
                            <label>Ticket Type</label>

                            <select name="ticket_type" required>

                                <option value="Full Ticket">
                                    Full Ticket ($<%= Number(event.full_ticket_price).toFixed(2) %>)
                                </option>

                                <option value="Concession Ticket">
                                    Concession Ticket ($<%= Number(event.concession_ticket_price).toFixed(2) %>)
                                </option>

                            </select>

                        </div>

                        <div class="form-group">
                            <label>Number of Tickets</label>

                            <input type="number" name="quantity" min="1" value="1" required>
                        </div>




                        <button type="submit" class="btn">
                            Book Course
                        </button>

                    </form>

        </div>

    </div>

</body>

</html>