<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>
        <%= event.title %> | EnrichHub
    </title>

    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: Arial, Helvetica, sans-serif;
        }

        body {
            background: #f4f6fb;
        }

        .sidebar {
            position: fixed;
            width: 250px;
            height: 100vh;
            background: #35503f9d;
            padding-top: 30px;
        }

        .sidebar h2 {
            color: white;
            text-align: center;
            margin-bottom: 30px;
        }

        .sidebar a {
            display: block;
            color: white;
            text-decoration: none;
            padding: 15px 25px;
        }

        .sidebar a:hover {
            background: rgba(255, 255, 255, 0.15);
        }

        .sidebar a.active {
            background: white;
            color: #35503f;
            font-weight: bold;
            border-left: 5px solid #fbbf24;
        }

        .main {
            margin-left: 250px;
            padding: 30px;
        }

        .back-btn {
            display: inline-block;
            background: #35503f9d;
            color: white;
            text-decoration: none;
            padding: 10px 20px;
            border-radius: 8px;
            margin-bottom: 25px;
            font-weight: bold;
        }

        .back-btn:hover {
            opacity: 0.9;
        }

        .card {
            background: white;
            padding: 35px;
            border-radius: 15px;
            box-shadow: 0 2px 10px rgba(0, 0, 0, .1);
        }

        .card h1 {
            color: #35503f;
        }

        .title {
            color: #35503f;
            margin-bottom: 15px;
        }

        .description {
            color: #222;
            line-height: 1.7;
            margin-bottom: 25px;
        }

        .details-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
            gap: 15px;
            margin-bottom: 30px;
        }

        .detail-box {
            background: #f8fafc;
            padding: 15px;
            border-radius: 10px;
        }

        .detail-box strong {
            display: block;
            color: #35503f;
            margin-bottom: 8px;
        }

        .section-title {
            color: #35503f;
            margin-bottom: 15px;
        }

        .ticket-card {
            background: #f8fafc;
            padding: 15px;
            border-radius: 10px;
            margin-bottom: 15px;
        }

        .price {
            font-size: 22px;
            font-weight: bold;
            color: #10b981;
            margin-top: 5px;
            margin-bottom: 5px;
        }

        .notice {
            background: #fff3cd;
            border-left: 5px solid #fbbf24;
            padding: 18px;
            border-radius: 10px;
            margin-top: 25px;
        }

        .notice h3 {
            margin-bottom: 10px;
        }

        .book-btn {
            display: inline-block;
            margin-top: 30px;
            background: #35503f;
            color: white;
            text-decoration: none;
            padding: 14px 30px;
            border-radius: 8px;
            font-weight: bold;
        }

        .book-btn:hover {
            opacity: 0.9;
        }

        .centre {
            text-align: center;
        }


        .sidebar-brand {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 0 20px;
            margin-bottom: 30px;
        }

        .sidebar-logo {
            width: 60px;
            height: 60px;
            border-radius: 50%;
            object-fit: cover;
        }

        .sidebar-brand h2 {
            color: white;
            margin: 0;
            font-size: 24px;
        }
    </style>

</head>

<body>

    <div class="sidebar">

        <div class="sidebar-brand">

            <img src="/logo.png" alt="EnrichHub Logo" class="sidebar-logo">

            <h2 onclick="location.href='/learner'" style="cursor:pointer;">
                EnrichHub
            </h2>

        </div>

        <a href="/learner">
            Learner Dashboard
        </a>

        <a href="/learner/courses" class="active">
            Browse Courses
        </a>

        <a href="/learner/bookings">
            My Bookings
        </a>

        <a href="/learner/profile">
            My Profile
        </a>


    </div>

    <div class="main">

        <a href="/learner/courses" class="back-btn">
            ← Back to Courses
        </a>

        <div class="card">

            <h1 class="title" style="font-size:38px;">
                <%= event.title %>
            </h1>

            <p class="description">
                <strong>Description</strong>
                <br><br>
                <%= event.description %>
            </p>

            <div style="
                background:#eef6f1;
                border-left:5px solid #35503f;
                padding:18px;
                border-radius:10px;
                margin-bottom:25px;
            ">

                <h3 style="
                    color:#35503f;
                    margin-bottom:10px;
                ">
                    Course Summary
                </h3>

                <p>
                    This course is designed for
                    <strong>
                        <%= event.age_group %>
                    </strong>
                    learners and will be conducted at
                    <strong>
                        <%= event.venue %>
                    </strong>
                    on
                    <strong>
                        <%= new Date(event.event_date).toLocaleDateString('en-GB') %>
                    </strong>.
                </p>

            </div>

            <h2 class="section-title">
                Course Details
            </h2>

            <div class="details-grid">

                <div class="detail-box">
                    <strong>Category</strong>
                    <%= event.category %>
                </div>

                <div class="detail-box">
                    <strong>Age Group</strong>
                    <%= event.age_group %>
                </div>

                <div class="detail-box">
                    <strong>Venue</strong>
                    <%= event.venue %>
                </div>

                <div class="detail-box">
                    <strong>Capacity</strong>
                    <%= event.capacity %> Learners
                </div>

                <div class="detail-box">
                    <strong>Course Date</strong>
                    <%= new Date(event.event_date).toLocaleDateString('en-GB') %>
                </div>

                <div class="detail-box">
                    <strong>Created On</strong>
                    <%= new Date(event.created_at).toLocaleDateString('en-GB') %>
                </div>

            </div>

            <h2 class="section-title">
                Ticket Information
            </h2>

            <div class="details-grid">

                <div class="detail-box">

                    <strong>🎟 Full Ticket</strong>

                    <div style="
                        font-size:30px;
                        font-weight:bold;
                        color:#0f4674;
                        margin:10px 0;
                    ">
                        $<%= Number(event.full_ticket_price).toFixed(2) %>
                    </div>

                    <p>
                        Available:
                        <%= event.full_tickets_left %> /
                            <%= event.full_ticket_qty %>
                    </p>

                    <p style="margin-top:8px;">
                        Sold:
                        <%= event.full_ticket_qty - event.full_tickets_left %>
                    </p>

                </div>

                <div class="detail-box">

                    <strong>🎟 Concession Ticket</strong>

                    <div style="
                        font-size:30px;
                        font-weight:bold;
                        color:#92400e;
                        margin:10px 0;
                    ">
                        $<%= Number(event.concession_ticket_price).toFixed(2) %>
                    </div>

                    <p>
                        Available:
                        <%= event.concession_tickets_left %> /
                            <%= event.concession_ticket_qty %>
                    </p>

                    <p style="margin-top:8px;">
                        Sold:
                        <%= event.concession_ticket_qty - event.concession_tickets_left %>
                    </p>

                </div>

            </div>

            <div class="notice">

                <h3>
                    Concession Ticket Eligibility
                </h3>

                <p>
                    Concession tickets are available for:
                </p>

                <ul style="margin-top:10px; margin-left:20px;">
                    <li>Learners under 18 years old</li>
                    <li>Seniors aged 50 - 65 years old</li>
                </ul>

            </div>

            <div class="centre">

                <a href="/learner/book/<%= event.id %>" class="book-btn">
                    Book This Course
                </a>

            </div>

        </div>

    </div>

</body>

</html>